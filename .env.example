# GitHub Authentication & Repository Settings
# Replace with your personal access token (requires 'repo' scope)
GITHUB_PAT=your_github_personal_access_token_here

# Target repository formatted as owner/repo
GITHUB_REPOSITORY=owner/repo

# Optional Settings
# Label to filter issues for processing (defaults to 'antigravity' if not set)
ISSUE_LABEL=antigravity

# Base development branch (defaults to 'main' if not set)
BASE_BRANCH=main

# Target directory of the project codebase (defaults to the directory containing main_agent.sh)
# PROJECT_DIR=/Users/akhlaqahmad/Documents/Projects/P/AT

# Polling interval in seconds for the scheduler daemon (defaults to 300 seconds / 5 minutes)
POLL_INTERVAL=300

# Deployment Settings (SSH and remote directory path)
# SSH="ssh -p port user@host"
# REMOTE_DIR="/path/to/remote/public_html"

# Workflow Control Settings
# CREATE_PR: true to push branch and create a PR; false to merge branch directly locally and push to origin
CREATE_PR=true

# DEPLOY_ON_SUCCESS: true to run deploy.sh upon issue completion; false to skip deployment
DEPLOY_ON_SUCCESS=true


